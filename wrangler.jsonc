{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "panel-miembros-ceer",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "panel-miembros-ceer-db", "database_id": "69759d89-e842-4122-b5b8-b14bb2ad2e6e" }
  ],
  // Páginas del CEER publicadas dentro del panel: el Worker pide sesión antes de servirlas
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  // Revisión horaria del acceso a GitHub (un miembro por corrida)
  "triggers": { "crons": ["17 * * * *"] },
  // El token de GitHub va como secreto (GITHUB_TOKEN), nunca en este archivo
  "observability": { "enabled": true }
}
